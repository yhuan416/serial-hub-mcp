# chmod 600 docker/serial-hub-mcp.env
SERIAL_HUB_MCP_HTTP_TOKEN=replace-with-mcp-bearer-token

# /info 上显示的访问地址；不设则用请求的 Host 头（不要用容器 hostname）
# SERIAL_HUB_MCP_PUBLIC_URL=http://192.168.4.50:8788

# remotes.json 里用 token_env 引用，不要把 hub token 写进镜像
LOCAL_HUB_TOKEN=replace-with-local-hub-token
N100_HUB_TOKEN=replace-with-n100-hub-token
ESP32_HUB_TOKEN=replace-with-esp32-hub-token
